    BUFFERPOOL BP0
    LOCKSIZE ANY
    LOCKMAX SYSTEM
    CLOSE NO
    CCSID EBCDIC;

  CREATE TABLE &$DBSCH..LOOKUPSRCKEY
     (ENVIRONID           INTEGER NOT NULL,
      LOOKUPSTEPID        INTEGER NOT NULL,
      KEYSEQNBR           INTEGER NOT NULL,
      FLDTYPE             INTEGER WITH DEFAULT NULL,
      LRFIELDID           INTEGER WITH DEFAULT NULL,
      LRLFASSOCID         INTEGER WITH DEFAULT NULL,
      LOOKUPID            INTEGER WITH DEFAULT NULL,
      VALUEFMTCD          CHAR(5) FOR SBCS DATA WITH DEFAULT NULL,
      SIGNED              SMALLINT WITH DEFAULT NULL,
      VALUELEN            INTEGER WITH DEFAULT NULL,
      DECIMALCNT          INTEGER WITH DEFAULT NULL,
      FLDCONTENTCD        CHAR(5) FOR SBCS DATA WITH DEFAULT NULL,
      ROUNDING            INTEGER WITH DEFAULT NULL,
      JUSTIFYCD           CHAR(5) FOR SBCS DATA WITH DEFAULT NULL,
      MASK                VARCHAR(48) FOR SBCS DATA WITH DEFAULT NULL,
      SYMBOLICNAME        VARCHAR(256) FOR SBCS DATA
        WITH DEFAULT NULL,
      VALUE               VARCHAR(256) FOR SBCS DATA
        WITH DEFAULT NULL,
      CREATEDTIMESTAMP    TIMESTAMP WITH DEFAULT,
      CREATEDUSERID       VARCHAR(48) FOR SBCS DATA WITH DEFAULT NULL,
      LASTMODTIMESTAMP    TIMESTAMP WITH DEFAULT,
      LASTMODUSERID       VARCHAR(48) FOR SBCS DATA WITH DEFAULT NULL,
      CONSTRAINT PK__LOOKUPSRCKEY
      PRIMARY KEY (ENVIRONID,
                   LOOKUPSTEPID,
                   KEYSEQNBR))
    IN &$DBNAME..LOOKUPSR
    AUDIT NONE
    DATA CAPTURE NONE
    CCSID      EBCDIC
    NOT VOLATILE;
  COMMIT;
