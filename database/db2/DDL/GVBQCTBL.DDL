      LOGRECID            INTEGER NOT NULL,
      NAME                VARCHAR(48) FOR SBCS DATA
        WITH DEFAULT NULL,
      DBMSCOLNAME         VARCHAR(48) FOR SBCS DATA
        WITH DEFAULT NULL,
      FIXEDSTARTPOS       INTEGER WITH DEFAULT NULL,
      ORDINALPOS          INTEGER WITH DEFAULT NULL,
      ORDINALOFFSET       INTEGER WITH DEFAULT NULL,
      REDEFINE            INT WITH DEFAULT NULL,
      COMMENTS            VARCHAR(256) FOR SBCS DATA
        WITH DEFAULT NULL,
      CREATEDTIMESTAMP    TIMESTAMP WITH DEFAULT,
      CREATEDUSERID       VARCHAR(48) FOR SBCS DATA WITH DEFAULT NULL,
      LASTMODTIMESTAMP    TIMESTAMP WITH DEFAULT,
      LASTMODUSERID       VARCHAR(48) FOR SBCS DATA WITH DEFAULT NULL,
      CONSTRAINT PK__LRFIELD
      PRIMARY KEY (ENVIRONID,
                   LRFIELDID))
    IN &$DBNAME..LRFIELD
    AUDIT NONE
    DATA CAPTURE NONE
    CCSID      EBCDIC
    NOT VOLATILE;
  COMMIT;
  CREATE SEQUENCE &$DBSCH..LRFIELD
  START WITH 1 NO ORDER CACHE 20;

