  CREATE TABLESPACE MIGRAUDT IN &$DBNAME.
    USING STOGROUP &$DBSG.
    BUFFERPOOL BP0
    LOCKSIZE ANY
    LOCKMAX SYSTEM
    CLOSE NO
    CCSID EBCDIC;

  CREATE TABLE &$DBSCH..MIGAUDIT
     (AUDITID              INTEGER NOT NULL GENERATED ALWAYS
        AS IDENTITY
          (START WITH 1, INCREMENT BY 1, CACHE 20, NO CYCLE,
           NO ORDER, MAXVALUE 2147483487, MINVALUE 1),
      SRCENVIRONID         INTEGER NOT NULL,
      DESTENVIRONID        INTEGER NOT NULL,
      ENTITYTYPE           VARCHAR(28) FOR SBCS DATA NOT NULL,
      ENTITYID             INTEGER NOT NULL,
      ENTITYNAME           VARCHAR(256) FOR SBCS DATA
        WITH DEFAULT NULL,
      MIGRATIONDATE        TIMESTAMP WITH DEFAULT NULL,
      MIGRATEDBY           CHAR(8) FOR SBCS DATA WITH DEFAULT NULL,
      MESSAGETEXT          VARCHAR(3000) FOR SBCS DATA
        WITH DEFAULT NULL,
      CONSTRAINT PK__MIGAUDIT
      PRIMARY KEY (AUDITID))
    IN &$DBNAME..MIGRAUDT
    AUDIT NONE
    DATA CAPTURE NONE
    CCSID      EBCDIC
    NOT VOLATILE;
  COMMIT;
