  CREATE TABLESPACE USERTS IN &$DBNAME.
    USING STOGROUP &$DBSG.
    BUFFERPOOL BP0
    LOCKSIZE ANY
    LOCKMAX SYSTEM
    CLOSE NO
    CCSID EBCDIC;

  CREATE TABLE &$DBSCH..USER
     (USERID              VARCHAR(48) FOR SBCS DATA NOT NULL,
      PASSWORD            VARCHAR(150) FOR SBCS DATA
        WITH DEFAULT NULL,
      FIRSTNAME           VARCHAR(48) FOR SBCS DATA
        WITH DEFAULT NULL,
      MIDDLEINIT          VARCHAR(1) FOR SBCS DATA WITH DEFAULT NULL,
      LASTNAME            VARCHAR(48) FOR SBCS DATA
        WITH DEFAULT NULL,
      EMAIL               VARCHAR(48) FOR SBCS DATA
        WITH DEFAULT NULL,
      DEFENVIRONID        INTEGER WITH DEFAULT NULL,
      DEFFOLDERID         INTEGER WITH DEFAULT NULL,
      DEFGROUPID          INTEGER WITH DEFAULT NULL,
      SYSADMIN            SMALLINT WITH DEFAULT NULL,
      LOGLEVEL            INTEGER WITH DEFAULT NULL,
      MAXCOMPILEERRORS    INTEGER WITH DEFAULT NULL,
      COMMENTS            VARCHAR(256) FOR SBCS DATA
      WITH DEFAULT NULL,
      CREATEDTIMESTAMP    TIMESTAMP WITH DEFAULT,
      CREATEDUSERID       VARCHAR(48) FOR SBCS DATA WITH DEFAULT NULL,
      LASTMODTIMESTAMP    TIMESTAMP WITH DEFAULT,
      LASTMODUSERID       VARCHAR(48) FOR SBCS DATA WITH DEFAULT NULL,
      CONSTRAINT PK__USER
      PRIMARY KEY (USERID))
    IN &$DBNAME..USERTS
    AUDIT NONE
    DATA CAPTURE NONE
    CCSID      EBCDIC
    NOT VOLATILE;
  COMMIT;
