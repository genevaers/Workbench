--
-- Create the tables for the GENEVAERS metadata
--
-- Replace tags in this file with system specific values.
-- Full stop is part of the tag name.
--
-- e.g. using ISPF editor 'CHANGE ALL &$DBSCH.. GENETEST'
--
-- 1) Replace user id with DBA access user id &$DBUSER.
-- 2) Replace occurrences of storage group &$DBSG.
-- 3) Replace occurrences of database &$DBNAME..
-- 4) Replace occurrences of schema &$DBSCH..
--
SET CURRENT SQLID='&$DBUSER.';

 SET CURRENT APPLICATION COMPATIBILITY = 'V12R1M503';
  CREATE TABLESPACE CODETABL IN &$DBNAME.
    USING STOGROUP &$DBSG.
    BUFFERPOOL BP0
    LOCKSIZE ANY
    LOCKMAX SYSTEM
    CLOSE NO
    CCSID EBCDIC;
  CREATE TABLE &$DBSCH..CODE
     (SRCID               CHAR(10) FOR SBCS DATA NOT NULL,
      KEYID               CHAR(5) FOR SBCS DATA NOT NULL,
      GENERALID           INTEGER WITH DEFAULT NULL,
      DESCRIPTION         VARCHAR(256) FOR SBCS DATA
        WITH DEFAULT NULL,
      CONSTRAINT PK__CODE
      PRIMARY KEY (SRCID,
                   KEYID))
    IN &$DBNAME..CODETABL
    AUDIT NONE
    DATA CAPTURE NONE
    CCSID      EBCDIC
    NOT VOLATILE;
  COMMIT;
-----------------------------------------------------------------------
  CREATE TABLESPACE CONTRLRC IN &$DBNAME.
    USING STOGROUP &$DBSG.
    BUFFERPOOL BP0
    LOCKSIZE ANY
    LOCKMAX SYSTEM
    CLOSE NO
    CCSID EBCDIC;

  CREATE TABLE &$DBSCH..CONTROLREC
     (ENVIRONID           INTEGER NOT NULL,
      CONTROLRECID        INTEGER
        GENERATED BY DEFAULT AS IDENTITY NOT NULL,
      NAME                VARCHAR(48) FOR SBCS DATA NOT NULL,
      FIRSTMONTH          INTEGER WITH DEFAULT NULL,
      LOWVALUE            INTEGER WITH DEFAULT NULL,
      HIGHVALUE           INTEGER WITH DEFAULT NULL,
      COMMENTS            VARCHAR(256) FOR SBCS DATA
        WITH DEFAULT NULL,
      CREATEDTIMESTAMP    TIMESTAMP WITH DEFAULT,
      CREATEDUSERID       VARCHAR(48) FOR SBCS DATA WITH DEFAULT NULL,
      LASTMODTIMESTAMP    TIMESTAMP WITH DEFAULT,
      LASTMODUSERID       VARCHAR(48) FOR SBCS DATA WITH DEFAULT NULL,
      CONSTRAINT PK__CONTROLREC
      PRIMARY KEY (ENVIRONID,
                   CONTROLRECID))
    IN &$DBNAME..CONTRLRC
    AUDIT NONE
    DATA CAPTURE NONE
    CCSID      EBCDIC
    NOT VOLATILE;
  COMMIT;
