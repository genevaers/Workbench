--
-- Create the indexes for the GENEVAERS metadata
--
-- Replace tags in this file with system specific values.
-- Full stop is part of the tag name.
--
-- e.g. using ISPF editor 'CHANGE ALL &$DBSCH.. GENETEST'
--
-- 1) Replace user id with DBA access user id &$DBUSER.
-- 2) Replace occurrences of storage group &$DBSG.
-- 3) Replace occurrences of schema &$DBSCH..
--
SET CURRENT SQLID='&$DBUSER';
  CREATE UNIQUE INDEX &$DBSCH..IDX_ENVIRON
    ON &$DBSCH..ENVIRON
     (ENVIRONID             ASC)
    USING STOGROUP &$DBSG
    PRIQTY 48 SECQTY 720
    ERASE  NO
    FREEPAGE 0 PCTFREE 10
    GBPCACHE CHANGED
    NOT CLUSTER
    BUFFERPOOL BP0
    CLOSE YES
    COPY NO
    PIECESIZE 2 G;
  COMMIT;
  CREATE UNIQUE INDEX &$DBSCH..IDX_VIEWFOLDER
    ON &$DBSCH..VIEWFOLDER
     (ENVIRONID             ASC,
      VIEWFOLDERID          ASC)
